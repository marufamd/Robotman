{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".output/**",
        ".vercel/output/**",
        "src/routeTree.gen.ts"
      ],
      "env": [
        "NODE_ENV",
        "NITRO_PRESET",
        "VERCEL"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    },
    "test": {
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
