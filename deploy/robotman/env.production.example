# Copy to /opt/robotman/.env on the server (chmod 600). Never commit the real file.
ROBOTMAN_IMAGE=ghcr.io/OWNER/robotman-server:latest
POSTGRES_PASSWORD=generate-a-long-random-password
DISCORD_PUBLIC_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# The Vercel dashboard's public origin, e.g. https://your-project.vercel.app (used for OAuth redirects and cookies).
DASHBOARD_ORIGIN=https://your-project.vercel.app
SESSION_SECRET=generate-with-openssl-rand-base64-48
COMICVINE_API_KEY=
OMDB_API_KEY=
YOUTUBE_API_KEY=
PASTEE_KEY=
