# Server: HTTP API and database
DISCORD_PUBLIC_KEY=replace_with_discord_application_public_key
POSTGRES_USER=robotman
POSTGRES_PASSWORD=replace_with_a_password
POSTGRES_DB=robotman
DATABASE_URL=postgres://robotman:replace_with_a_password@localhost:5433/robotman
# Optional Docker Compose host ports
POSTGRES_PORT=5433
SERVER_PORT=3001

# Server: Discord OAuth and command registration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DASHBOARD_ORIGIN=http://localhost:3000
SESSION_SECRET=
NODE_ENV=development
# Optional server setting: register commands in one guild during development
DISCORD_TEST_GUILD_ID=

# Dashboard: local development server and server-side API proxy
DASHBOARD_PORT=3000
ROBOTMAN_API_ORIGIN=http://localhost:3001

# Server: credentialed lookup providers
COMICVINE_API_KEY=
OMDB_API_KEY=
YOUTUBE_API_KEY=
# Used by /shows to publish comment templates; the command sends a .txt file if unset.
PASTEE_KEY=
