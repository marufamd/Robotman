DISCORD_PUBLIC_KEY=replace_with_discord_application_public_key
POSTGRES_USER=robotman
POSTGRES_PASSWORD=replace_with_a_password
POSTGRES_DB=robotman
DATABASE_URL=postgres://robotman:replace_with_a_password@localhost:5432/robotman
PORT=3001

# Discord OAuth and command registration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DASHBOARD_ORIGIN=http://localhost:3000
SESSION_SECRET=
NODE_ENV=development
# Optional: register commands in one guild during development
DISCORD_TEST_GUILD_ID=

# Dashboard server-side proxy (set separately in Vercel)
ROBOTMAN_API_ORIGIN=http://localhost:3001

# Credentialed lookup providers
COMICVINE_API_KEY=
OMDB_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=
YOUTUBE_API_KEY=

# Weekly comic release-list posting (disabled until a channel is configured)
RELEASE_LIST_CHANNEL_ID=
RELEASE_LIST_TIMEZONE=UTC
RELEASE_LIST_DAY_OF_WEEK=0
RELEASE_LIST_HOUR=0
RELEASE_LIST_MINUTE=0
# Optional comma-separated TVmaze show IDs
TVMAZE_SHOW_IDS=
