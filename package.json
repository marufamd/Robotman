{
  "name": "robotman",
  "version": "7.0.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build --cache-dir=.turbo/cache",
    "dev": "turbo run dev --cache-dir=.turbo/cache",
    "typecheck": "turbo run typecheck --cache-dir=.turbo/cache",
    "test": "node scripts/test-integration.mjs",
    "test:docker": "node --test test/docker.test.mjs",
    "register:commands": "pnpm --filter @robotman/server register:commands"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  }
}
